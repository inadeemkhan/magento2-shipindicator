<?php
declare(strict_types=1);

/**
 * Free Shipping Indicator Template
 *
 * @var \NadeemSoft\ShipIndicator\Block\Cart\Indicator $block
 * @var \Magento\Framework\Escaper $escaper
 */

if (!$block->canRender()) {
    return;
}
?>
<style>
:root {
    --freeship-bg-color: <?= $escaper->escapeHtml($block->getMessageBackground()) ?>;
    --freeship-text-color: <?= $escaper->escapeHtml($block->getMessageTextColor()) ?>;
    --freeship-font-size: <?= (int)$block->getFontSize() ?>px;
    --freeship-progress-color: <?= $escaper->escapeHtml($block->getProgressBarColor()) ?>;
}
<?= /* @noEscape */ $block->getCustomCSS() ?>
</style>

<div class="freeship-section">
    <?php if (!$block->isOrderEligibleForFreeShipping()): ?>
        <?php $progress = $block->getFreeShippingCompletionRate(); ?>

        <div class="freeship-indicator-wrapper">
            <span class="min"><?= $escaper->escapeHtml($block->getFormattedPrice(0, 0)) ?></span>

            <div class="freeship-indicator">
                <div class="freeship-indicator-bg"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="<?= (int)$progress ?>">
                    <div class="freeship-indicator-fill freeship-indicator-progress"
                         style="width: <?= (float)$progress ?>%;"></div>
                </div>
            </div>

            <span class="max"><?= $escaper->escapeHtml($block->getFormattedPrice($block->getFreeShippingMinValue(), 0)) ?></span>
        </div>

        <p class="message">
            <?= $escaper->escapeHtml(__($block->getTextMessage())) ?>
            <span class="freeship-price"><?= $escaper->escapeHtml($block->getFormattedPrice($block->getFreeShippingAmountDifference())) ?></span>
            <?php if ($block->isTaxIncluded()): ?>
                <small>(<?= $escaper->escapeHtml(__('incl. tax')) ?>)</small>
            <?php endif; ?>
        </p>
    <?php else: ?>
        <div class="freeship-text">
            <p><?= $escaper->escapeHtml(__($block->getEligibleTextMessage())) ?></p>
        </div>
    <?php endif; ?>
</div>
